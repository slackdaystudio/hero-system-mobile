p":false,"selected":true,"notes":null},{"xmlid":"CAPABILITIES","id":1557706563363,"basecost":10,"levels":0,"alias":"Capabilities","position":-1,"multiplier":1,"graphic":"Burst","color":"255 255 255","sfx":"Default","showActiveCost":true,"option":"AS","optionid":"AS","optionAlias":"(As Pow","includeNotesInPrintout":true,"name":null,"showalias":true,"private":false,"required":true,"includeinbase":true,"displayinstring":true,"group":false,"selected":true,"notes":null},{"xmlid":"MOTIVATION","id":1557706563369,"basecost":0,"levels":0,"alias":"Motivation","position":-1,"multiplier":1,"graphic":"Burst","color":"255 255 255","sfx":"Default","showActiveCost":true,"option":"HARSH","optionid":"HARSH","optionAlias":"Harshly Punish","includeNotesInPrintout":true,"name":null,"showalias":true,"private":false,"required":true,"includeinbase":true,"displayinstring":true,"group":false,"selected":true,"notes":null}]},{"xmlid":"PSYCHOLOGICALLIMITATION","id":1436908216890,"basecost":0,"levels":0,"alias":"Psychological Complication","position":2,"multiplier":1,"graphic":"Burst","color":"255 255 255","sfx":"Default","showActiveCost":true,"includeNotesInPrintout":false,"name":null,"input":"Believes \"The System\" Does Not Work","notes":"The character has lost faith in social institutions, such as the legal, political or medical system. He does not believe that the guilty will be convicted and the innocent exonerated, that good leaders will be elected or appointed; or that doctors are really doing their best to cure their patients. Depending on his other attitudes, the character may become a vigilante, a criminal, a rebel or simply apathetic.\n\nAt the moderate level, the character can still work inside the system when necessary; there are parts of it that still function adequately. At the strong level, the character finds it much more difficult to keep in line.\n\nIn the character is vocal about his beliefs, he may also have the Reputation \"Seen as a Troublemaker\".","adder":[{"xmlid":"SITUATION","id":1557685257749,"basecost":10,"levels":0,"alias":"Situation Is","position":-1,"multiplier":1,"graphic":"Burst","color":"255 255 255","sfx":"Default","showActiveCost":true,"option":"COMMON","optionid":"COMMON","optionAlias":"(Common","includeNotesInPrintout":true,"name":null,"showalias":true,"private":false,"required":true,"includeinbase":true,"displayinstring":true,"group":false,"selected":true,"notes":null},{"xmlid":"INTENSITY","id":1557685257755,"basecost":0,"levels":0,"alias":"Intensity Is","position":-1,"multiplier":1,"graphic":"Burst","color":"255 255 255","sfx":"Default","showActiveCost":true,"option":"MODERATE","optionid":"MODERATE","optionAlias":"Moderate","includeNotesInPrintout":true,"name":null,"showalias":true,"private":false,"required":true,"includeinbase":true,"displayinstring":true,"group":false,"selected":true,"notes":null}]},{"xmlid":"PSYCHOLOGICALLIMITATION","id":1557685605504,"basecost":0,"levels":0,"alias":"Psychological Complication","position":3,"multiplier":1,"graphic":"Burst","color":"255 255 255","sfx":"Default","showActiveCost":true,"includeNotesInPrintout":false,"name":null,"input":"Bitter","notes":"This character is disappointed and unpleasant about something in his life. He is not necessarily unfriendly or antisocial, but has a very negative worldview and feels that life keeps screwing him over (and over, and over, and over). Some characters are quietly bitter, while others feel the need to let everyone around them know how bitter they are at least once per adventure.","adder":[{"xmlid":"SITUATION","id":1557685662029,"basecost":10,"levels":0,"alias":"Situation Is","position":-1,"multiplier":1,"graphic":"Burst","color":"255 255 255","sfx":"Default","showActiveCost":true,"option":"COMMON","optionid":"COMMON","optionAlias":"(Common","includeNotesInPrintout":true,"name":null,"showalias":true,"private":false,"required":true,"includeinbase":true,"displayinstring":true,"group":false,"selected":true,"notes":null},{"xmlid":"INTENSITY","id":1557685662035,"basecost":0,"levels":0,"alias":"Intensity Is","position":-1,"multiplier":1,"graphic":"Burst","color":"255 255 255","sfx":"Default","showActiveCost":true,"option":"MODERATE","optionid":"MODERATE","optionAlias":"Moderate","includeNotesInPrintout":true,"name":null,"showalias":true,"private":false,"required":true,"includeinbase":true,"displayinstring":true,"group":false,"selected":true,"notes":null}]},{"xmlid":"SOCIALLIMITATION","id":1556053171609,"basecost":0,"levels":0,"alias":"Social Complication","position":4,"multiplier":1,"graphic":"Burst","color":"255 255 255","sfx":"Default","showActiveCost":true,"includeNotesInPrintout":false,"name":null,"input":"Criminal Conviction","notes":"The character has been convicted of a crime at some point in his past. The frequency determines just how well known that conviction is. Effects can range from merely being snubbed or turned down for good jobs, through beatings and denial of housing, to even being lynched, depending on the nature of the crime. Note that the character does not actually need to have been convicted, so long as those around him think he was.\n\nThis Disadvantage is in fact more limiting to those who are innocent of the crimes listed. This Disadvantage often is accompanied by Monitored By His Probation Officer or Monitored By The Police, or even a Hunted if the character failed to serve out his sentence. Particularly vile, spectacular, or famous crimes may also rate a negative Reputation.","adder":[{"xmlid":"OCCUR","id":1557685281334,"basecost":5,"levels":0,"alias":"Circumstances Occur","position":-1,"multiplier":1,"graphic":"Burst","color":"255 255 255","sfx":"Default","showActiveCost":true,"option":"OCCASIONALLY","optionid":"OCCASIONALLY","optionAlias":"Infrequently","includeNotesInPrintout":true,"name":null,"showalias":true,"private":false,"required":true,"includeinbase":true,"displayinstring":true,"group":false,"selected":true,"notes":null},{"xmlid":"EFFECTS","id":1557685281340,"basecost":0,"levels":0,"alias":"Effects of Restrictions","position":-1,"multiplier":1,"graphic":"Burst","color":"255 255 255","sfx":"Default","showActiveCost":true,"option":"MINOR","optionid":"MINOR","optionAlias":"Minor","includeNotesInPrintout":true,"name":null,"showalias":true,"private":false,"required":true,"includeinbase":true,"displayinstring":true,"group":false,"selected":true,"notes":null}]},{"xmlid":"SOCIALLIMITATION","id":1437016632918,"basecost":0,"levels":0,"alias":"Social Complication","position":5,"multiplier":1,"graphic":"Burst","color":"255 255 255","sfx":"Default","showActiveCost":true,"includeNotesInPrintout":true,"name":null,"input":"Minor (Under 18)","notes":null,"adder":[{"xmlid":"OCCUR","id":1437108434534,"basecost":5,"levels":0,"alias":"Circumstances Occur","position":-1,"multiplier":1,"graphic":"Burst","color":"255 255 255","sfx":"Default","showActiveCost":true,"option":"OCCASIONALLY","optionid":"OCCASIONALLY","optionAlias":"Infrequently","includeNotesInPrintout":true,"name":null,"showalias":true,"private":false,"required":true,"includeinbase":true,"displayinstring":true,"group":false,"selected":true,"notes":null},{"xmlid":"EFFECTS","id":1437108434540,"basecost":0,"levels":0,"alias":"Effects of Restrictions","position":-1,"multiplier":1,"graphic":"Burst","color":"255 255 255","sfx":"Default","showActiveCost":true,"option":"MINOR","optionid":"MINOR","optionAlias":"Minor","includeNotesInPrintout":true,"name":null,"showalias":true,"private":false,"required":true,"includeinbase":true,"displayinstring":true,"group":false,"selected":true,"notes":null}]},{"xmlid":"SOCIALLIMITATION","id":1557685332028,"basecost":0,"levels":0,"alias":"Social Complication","position":6,"multiplier":1,"graphic":"Burst","color":"255 255 255","sfx":"Default","showActiveCost":true,"includeNotesInPrintout":false,"name":null,"input":"Stud Magnet","notes":"A character with this Social Limitation seems to draw girls to him like flowers draw bees. He can charm the pants off of pretty much any girl (of any age) without even trying... and he usually doesn't try. He knows precisely what to do, and what to say, to make the female heart go pitty-pat. Ironically, he's usually utterly ignorant of his effect on women, and thus is utterly confused when other men take a dislike to him (because their girlfriends find him attractive) and women seem to be competing over him.","adder":[{"xmlid":"OCCUR","id":1557685388403,"basecost":10,"levels":0,"alias":"Circumstances Occur","position":-1,"multiplier":1,"graphic":"Burst","color":"255 255 255","sfx":"Default","showActiveCost":true,"option":"FREQUENTLY","optionid":"FREQUENTLY","optionAlias":"Frequently","includeNotesInPrintout":true,"name":null,"showalias":true,"private":false,"required":true,"includeinbase":true,"displayinstring":true,"group":false,"selected":true,"notes":null},{"xmlid":"EFFECTS","id":1557685388409,"basecost":0,"levels":0,"alias":"Effects of Restrictions","position":-1,"multiplier":1,"graphic":"Burst","color":"255 255 255","sfx":"Default","showActiveCost":true,"option":"MINOR","optionid":"MINOR","optionAlias":"Minor","includeNotesInPrintout":true,"name":null,"showalias":true,"private":false,"required":true,"includeinbase":true,"displayinstring":true,"group":false,"selected":true,"notes":null}]}]},"equipment":null,"rules":{"name":"Default","path":"Gravity Girl.hdc","basepoints":200,"disadpoints":150,"apperend":10,"strapperend":10,"ncmselected":false,"ncmuserchangeable":true,"attackapmaxvalue":90,"attackapmaxresponse":0,"defenseapmaxvalue":90,"defenseapmaxresponse":0,"disadcategorymaxvalue":75,"disadcategorymaxresponse":0,"availdisadpointsresponse":0,"availtotalpointsresponse":0,"characteristicmaxvalue":1000,"characteristicmaxresponse":0,"maneuvermaxvalue":1000,"maneuvermaxresponse":0,"skillmaxvalue":1000,"skillmaxresponse":0,"perkmaxvalue":1000,"perkmaxresponse":0,"talentmaxvalue":1000,"talentmaxresponse":0,"powermaxvalue":1000,"powermaxresponse":0,"equipmentcostvalue":1000,"equipmentcostresponse