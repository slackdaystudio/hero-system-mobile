# Copy to keystore.properties (gitignored) and fill in with the LEGACY app's
# existing upload key — com.herogmtools is a store cutover, so a new key would be
# rejected by Play. storeFile is resolved relative to android/app/.
storeFile=herogmtools-upload.keystore
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
